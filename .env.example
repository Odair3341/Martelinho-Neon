# Supabase Configuration (preencha com os valores do seu projeto)
VITE_SUPABASE_URL=<your-supabase-url>
VITE_SUPABASE_ANON_KEY=<your-anon-key>
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Backend da API (usado pelo app Android nativo via CapacitorHttp)
# No app nativo, chamadas /api/* são redirecionadas para esta URL
VITE_API_BASE_URL=https://martelinho-neon.vercel.app
